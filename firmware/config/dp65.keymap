/*
 * DP65 default ZMK keymap scaffold.
 *
 * Layout is intentionally conservative until the final PCB netlist and physical
 * legends are confirmed. The AS5600 scrubber will be added as sensor bindings
 * after an AS5600 ZMK driver/module is introduced.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define FN 1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6      &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp LBKT    &kp Y     &kp U     &kp I     &kp O     &kp P     &kp RBKT  &kp BSLH
                &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G     &kp SEMI    &kp H     &kp J     &kp K     &kp L     &kp SQT   &kp RET
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B                 &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP
                &kp LCTRL &kp LGUI  &kp LALT  &mo FN    &kp SPACE                       &kp SPACE &kp RALT  &kp RCTRL &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp F6       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp DEL
                &kp GRAVE  &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp LBRC     &kp INS   &kp HOME  &kp UP    &kp END   &kp PSCRN &kp RBRC  &kp PIPE
                &trans     &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &kp COLON    &kp PG_UP &kp LEFT  &kp DOWN  &kp RIGHT &kp DQT   &trans
                &trans     &kp CARET    &kp AMPS     &kp ASTRK    &kp LPAR     &kp RPAR                 &kp PG_DN &kp PLUS  &kp MINUS &kp EQUAL &kp SLASH &trans   &kp C_VOL_UP
                &trans     &trans       &trans       &trans       &trans                             &trans   &trans    &trans    &kp C_PREV &kp C_VOL_DN &kp C_NEXT
            >;
        };
    };
};
