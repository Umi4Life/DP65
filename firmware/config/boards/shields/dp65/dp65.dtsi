/*
 * DP65 ZMK shield scaffold.
 *
 * Hardware target:
 * - split 65% keyboard
 * - nice!nano / nice!nano v2 controller footprint
 * - nice!view display via ZMK's nice_view_adapter + nice_view shields
 * - AS5600 magnetic encoder/scrubber reserved on I2C for future driver support
 *
 * This file intentionally does not vendor ZMK. The firmware tree is a standard
 * ZMK user-config style module pulled by west from firmware/config/west.yml.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &dp65_layout;
    };

    dp65_layout: dp65_layout {
        compatible = "zmk,physical-layout";
        display-name = "DP65";
        transform = <&default_transform>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;

        /*
         * DP65 PCB notes currently identify a 65-key design with 5 row nets and
         * seven column nets per half. The map below exposes 64 key positions;
         * the large scrubber/encoder is handled through sensor bindings once
         * the AS5600 driver/module is added.
         *
         * Left half columns are 0..6, right half columns are 7..13.
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)   RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)   RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)   RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)           RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)                    RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        /* TODO: confirm against final PCB netlist before flashing hardware. */
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

&pro_micro_i2c {
    status = "okay";

    /*
     * Placeholder for the AS5600 magnetic encoder/scrubber.
     *
     * Typical AS5600 I2C address is 0x36. This node is disabled until a ZMK
     * compatible sensor/input driver is added. Leaving it disabled keeps the
     * scaffold buildable while documenting the hardware integration point.
     */
    as5600: as5600@36 {
        compatible = "ams,as5600";
        reg = <0x36>;
        status = "disabled";
    };
};
